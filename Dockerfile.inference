FROM python:3.12-slim

ARG APP_UID=1000
ARG APP_GID=1000

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.1.0" \
    && python -m pip install "sentencepiece>=0.1.99"

RUN groupadd --gid "${APP_GID}" glyph \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /usr/sbin/nologin glyph

WORKDIR /app

COPY config.py generate.py ./
COPY model ./model
COPY inference ./inference

RUN mkdir -p /app/checkpoints /app/data/processed \
    && chown -R glyph:glyph /app

USER glyph

EXPOSE 8195

CMD ["python", "inference/server.py"]
